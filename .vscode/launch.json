    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch showheaders",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/showheaders",
            "args": [],
            "env": {},
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Launch showheaders (Custom Port)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/showheaders",
            "args": ["-port", "3000"],
            "env": {},
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Launch showheaders (Localhost Only)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/showheaders",
            "args": ["-hostname", "localhost", "-port", "8080"],
            "env": {},
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - Current File",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - All Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/...",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - Handlers",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/handlers",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - Middleware",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/middleware",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - Config",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/config",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test - Server",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/server",
            "args": ["-test.v"],
            "cwd": "${workspaceFolder}"
        }
